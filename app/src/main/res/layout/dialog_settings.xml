<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsActivityRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLow">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLow"
        app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/settingsToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_left_arrow_mt"
            app:navigationIconTint="?attr/colorOnSurface"
            app:title="@string/settings"
            android:background="?attr/colorSurfaceContainerLow"
            app:titleTextColor="?attr/colorOnSurface" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="0dp"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:clipToPadding="false">
        <LinearLayout
            android:id="@+id/settingsRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:focusableInTouchMode="true">
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Hexora.Settings.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="16dp"
                android:hint="@string/settings_search_hint"
                app:startIconDrawable="@drawable/baseline_search_24"
                app:startIconTint="?attr/colorOnSurfaceVariant"
                app:endIconMode="clear_text">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/settingsSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:inputType="textCapSentences"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Hexora.Settings.Card"
                android:id="@+id/settingsThemeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/theme_label"
                        android:textColor="?attr/colorOnSurface"
                        style="@style/Widget.Hexora.Settings.Title" />

                    <TextView
                        style="@style/Widget.Hexora.Settings.Summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_theme_summary"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/themeToggleGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/lightThemeButton"
                            style="@style/Widget.Hexora.Settings.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:text="@string/theme_light_label"
                            android:textAllCaps="false"
                            android:textColor="@color/theme_choice_content"
                            app:backgroundTint="@color/theme_choice_background"
                            app:strokeColor="?attr/colorOutlineVariant"
                            app:icon="@drawable/light"
                            app:iconTint="@color/theme_choice_content"
                            app:iconGravity="textStart"
                            app:iconSize="20dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/darkThemeButton"
                            style="@style/Widget.Hexora.Settings.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:text="@string/theme_dark_label"
                            android:textAllCaps="false"
                            android:textColor="@color/theme_choice_content"
                            app:backgroundTint="@color/theme_choice_background"
                            app:strokeColor="?attr/colorOutlineVariant"
                            app:icon="@drawable/dark"
                            app:iconTint="@color/theme_choice_content"
                            app:iconGravity="textStart"
                            app:iconSize="20dp" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Hexora.Settings.Card"
                android:id="@+id/settingsAppearanceSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <include
                        layout="@layout/item_settings_section_header" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:tag="settings_content"
                        android:visibility="gone"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="12dp"
                            android:background="?attr/colorOutlineVariant" />

                        <TextView
                            android:id="@+id/fileSizeLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="?attr/colorOnSurface" />

                        <SeekBar
                            android:id="@+id/fileSizeSeek"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="80"
                            android:minHeight="48dp" />

                        <LinearLayout
                            android:id="@+id/fileSizePreview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_settings_preview"
                            android:padding="8dp" />

                        <TextView
                            android:id="@+id/fileLinesLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="?attr/colorOnSurface" />

                        <SeekBar
                            android:id="@+id/fileLinesSeek"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="7"
                            android:layout_marginBottom="8dp"
                            android:minHeight="48dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Hexora.Settings.Dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/date_format">
                            <AutoCompleteTextView
                                android:id="@+id/dateFormatTv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface"
                                android:minHeight="56dp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Hexora.Settings.Dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/language">
                            <AutoCompleteTextView
                                android:id="@+id/languageTv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface"
                                android:minHeight="56dp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Hexora.Settings.Dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/pane_highlight_style">
                            <AutoCompleteTextView
                                android:id="@+id/paneHighlightTv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface"
                                android:minHeight="56dp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/paneHighlightAnimateSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pane_highlight_animate"
                            style="@style/Widget.Hexora.Settings.Switch" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Hexora.Settings.Dropdown"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:hint="@string/app_font">
                                <AutoCompleteTextView
                                    android:id="@+id/fontTv"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none"
                                    android:textSize="14sp"
                                    android:textColor="?attr/colorOnSurface"
                                    android:minHeight="56dp" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/pickFontBtn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/settings_import_font"
                                style="@style/Widget.Hexora.Settings.Button" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Hexora.Settings.Card"
                android:id="@+id/settingsFoldersSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <include
                        layout="@layout/item_settings_section_header" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:tag="settings_content"
                        android:visibility="gone"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="12dp"
                            android:background="?attr/colorOutlineVariant" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Hexora.Settings.Dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/startup_pane_1">
                            <AutoCompleteTextView
                                android:id="@+id/startupTv1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface"
                                android:minHeight="56dp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Hexora.Settings.Dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/startup_pane_2">
                            <AutoCompleteTextView
                                android:id="@+id/startupTv2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface"
                                android:minHeight="56dp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_folder_1"
                                    android:textSize="12sp"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:id="@+id/homePathTv1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:ellipsize="middle"
                                    android:textColor="?attr/colorOnSurface"
                                    android:maxLines="2" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/pickHomeBtn1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_change"
                                style="@style/Widget.Hexora.Settings.Button"
                                android:layout_marginStart="12dp"
                                android:minWidth="76dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_folder_2"
                                    android:textSize="12sp"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:id="@+id/homePathTv2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:ellipsize="middle"
                                    android:textColor="?attr/colorOnSurface"
                                    android:maxLines="2" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/pickHomeBtn2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_change"
                                style="@style/Widget.Hexora.Settings.Button"
                                android:layout_marginStart="12dp"
                                android:minWidth="76dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/app_path_dir"
                                    android:textSize="12sp"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:id="@+id/appPathTv"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:ellipsize="middle"
                                    android:textColor="?attr/colorOnSurface"
                                    android:maxLines="2" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/pickAppPathBtn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_change"
                                style="@style/Widget.Hexora.Settings.Button"
                                android:layout_marginStart="12dp"
                                android:minWidth="76dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Hexora.Settings.Card"
                android:id="@+id/settingsFilesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <include
                        layout="@layout/item_settings_section_header" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:tag="settings_content"
                        android:visibility="gone"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="12dp"
                            android:background="?attr/colorOutlineVariant" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/backupSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/gen_backup"
                            style="@style/Widget.Hexora.Settings.Switch" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/preserveSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/preserve_mtime"
                            style="@style/Widget.Hexora.Settings.Switch" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/customizeMenuBtn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/customize_file_menu"
                            style="@style/Widget.Hexora.Settings.Button"
                            android:layout_marginTop="8dp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/fileMenuTwoColumnSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/two_column_file_menu"
                            style="@style/Widget.Hexora.Settings.Switch" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Hexora.Settings.Dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/compression_level">
                            <AutoCompleteTextView
                                android:id="@+id/compressLevelTv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface"
                                android:minHeight="56dp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Hexora.Settings.Card"
                android:id="@+id/settingsAccessSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <include
                        layout="@layout/item_settings_section_header" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:tag="settings_content"
                        android:visibility="gone"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="12dp"
                            android:background="?attr/colorOutlineVariant" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Hexora.Settings.Dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/access_mode">
                            <AutoCompleteTextView
                                android:id="@+id/workingModeTv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface"
                                android:minHeight="56dp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            style="@style/Widget.Hexora.Settings.Summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_access_status"
                            android:layout_marginTop="12dp" />

                        <com.google.android.material.chip.ChipGroup
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="0dp">
                            <com.google.android.material.chip.Chip
                                android:id="@+id/rootStatusSwitch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/root_available"
                                style="@style/Widget.Hexora.Settings.Status" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/shizukuStatusSwitch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/shizuku_status"
                                style="@style/Widget.Hexora.Settings.Status" />
                        </com.google.android.material.chip.ChipGroup>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/grantShizukuBtn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/grant_shizuku"
                            android:visibility="gone"
                            style="@style/Widget.Hexora.Settings.Button"
                            android:layout_marginTop="4dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/su_command"
                            style="@style/Widget.Hexora.Settings.Input">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/suCommandEt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:inputType="text"
                                android:singleLine="true"
                                android:textColor="?attr/colorOnSurface"
                                android:minHeight="56dp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/silentInstallToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/root_install"
                            android:enabled="false"
                            style="@style/Widget.Hexora.Settings.Switch" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/rootFileOpsToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/root_file_operations"
                            android:enabled="false"
                            style="@style/Widget.Hexora.Settings.Switch" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/shizukuFileOpsToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/shizuku_file_operations"
                            android:enabled="false"
                            style="@style/Widget.Hexora.Settings.Switch" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/rootExtractorToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/root_extractor_features"
                            android:enabled="false"
                            style="@style/Widget.Hexora.Settings.Switch" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/rebootMenuBtn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/reboot_options"
                            android:visibility="gone"
                            style="@style/Widget.Hexora.Settings.Button"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Hexora.Settings.Card"
                android:id="@+id/settingsBehaviorSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <include
                        layout="@layout/item_settings_section_header" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:tag="settings_content"
                        android:visibility="gone"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="12dp"
                            android:background="?attr/colorOutlineVariant" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/logToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/enable_logs"
                            style="@style/Widget.Hexora.Settings.Switch" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/playerModeToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/open_player_as_act"
                            style="@style/Widget.Hexora.Settings.Switch" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/fixMimeTypeToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/fix_mime_type"
                            style="@style/Widget.Hexora.Settings.Switch" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/askBookmarkTabToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ask_bookmark_tab"
                            style="@style/Widget.Hexora.Settings.Switch" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sidebarBookmarksToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/show_bookmarks_sidebar"
                            style="@style/Widget.Hexora.Settings.Switch" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/sidebarBookmarkGroupsToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/include_bookmark_groups_sidebar"
                            style="@style/Widget.Hexora.Settings.Switch" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/search_history_limit"
                            style="@style/Widget.Hexora.Settings.Input">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/searchHistoryLimitEt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:inputType="number"
                                android:singleLine="true"
                                android:textColor="?attr/colorOnSurface"
                                android:minHeight="56dp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Hexora.Settings.Card"
                android:id="@+id/settingsSigningSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <include
                        layout="@layout/item_settings_section_header" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:tag="settings_content"
                        android:visibility="gone"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="12dp"
                            android:background="?attr/colorOutlineVariant" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:text="@string/auto_sign"
                                android:textSize="14sp"
                                android:id="@+id/autosign"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="52dp"
                                android:textColor="?attr/colorOnSurface" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/sign_settings"
                                android:text="@string/sign_set"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                style="@style/Widget.Hexora.Settings.Button" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Hexora.Settings.Card"
                android:id="@+id/settingsUpdatesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <include
                        layout="@layout/item_settings_section_header" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:tag="settings_content"
                        android:visibility="gone"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="12dp"
                            android:background="?attr/colorOutlineVariant" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/checkUpdatesToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/check_for_updates"
                            android:minHeight="52dp"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/checkUpdateNow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/check_update_now"
                            style="@style/Widget.Hexora.Settings.Button" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.Hexora.Settings.Summary"
                android:id="@+id/settingsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/settings_no_results"
                android:visibility="gone"
                android:accessibilityLiveRegion="polite" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about"
                style="@style/Widget.Hexora.Settings.Button"
                app:icon="@drawable/baseline_info_24"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
