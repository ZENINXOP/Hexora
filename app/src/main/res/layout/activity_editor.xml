<?xml version="1.0" encoding="utf-8"?>
<io.github.abdurazaaqmohammed.ui.MyDrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="@drawable/baseline_menu_24">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btn_minimize"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_editor_pin"
                        app:tint="?attr/colorOnSurface"
                        android:contentDescription="@string/hexora_minimize" />

                    <ImageButton
                        android:id="@+id/btn_undo"
                        android:enabled="false"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/undo_24px"
                        android:contentDescription="@string/undo"/>

                    <ImageButton
                        android:id="@+id/btn_redo"
                        android:enabled="false"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/undo_24px"
                        android:scaleX="-1"
                        android:contentDescription="@string/redo"/>

                    <ImageButton
                        android:id="@+id/btn_save"
                        android:enabled="false"
                        android:alpha="0.38"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/save_24px"
                        android:contentDescription="@string/save"/>

                    <ImageButton
                        android:id="@+id/btn_edit"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/edit_24px"
                        android:contentDescription="@string/edit"/>

                    <ImageButton
                        android:id="@+id/btn_file"
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/baseline_more_vert_24"
                        android:contentDescription="@string/file_options"/>

                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <LinearLayout
            android:id="@+id/editor_file_info"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="?attr/colorSurfaceContainerLow"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/editor_file_name"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/editor_file_status"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:paddingStart="12dp"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/editor_text_pages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/colorSurfaceContainerLow"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/editor_text_previous"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/previous" />

            <TextView
                android:id="@+id/editor_text_page"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/editor_text_go_to_page"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/editor_text_next"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/next" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/editor_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface"
        android:elevation="16dp"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/drawer_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/opened_files" />

        <modder.hub.dexeditor.views.FastScrollerRecyclerView
            android:id="@+id/tabs_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/action_minimize"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:drawablePadding="16dp"
            android:background="?attr/selectableItemBackground"
            android:text="@string/hexora_minimize"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            app:drawableStartCompat="@drawable/ic_minimize"
            app:drawableTint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

</io.github.abdurazaaqmohammed.ui.MyDrawerLayout>
